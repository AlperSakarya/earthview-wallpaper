#!/bin/bash
set -e

# Create symlink for the executable
if [ ! -L /usr/bin/earthview-wallpaper ]; then
    ln -sf /usr/share/earthview/indicator.py /usr/bin/earthview-wallpaper
fi

# Ensure the script is executable
chmod +x /usr/share/earthview/indicator.py

# Update icon cache
if command -v gtk-update-icon-cache > /dev/null 2>&1; then
    gtk-update-icon-cache -f /usr/share/icons/hicolor/ 2>/dev/null || true
fi

# Update desktop database
if command -v update-desktop-database > /dev/null 2>&1; then
    update-desktop-database /usr/share/applications/ 2>/dev/null || true
fi

echo "Earth View Wallpaper Engine v2.0 installed successfully."
echo "Launch from applications menu or run: earthview-wallpaper"
